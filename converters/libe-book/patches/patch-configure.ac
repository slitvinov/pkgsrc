$NetBSD$

Link with icu-uc: the charset converter calls ucnv_*, and icu-i18n
lists icu-uc only in Requires.private.

--- configure.ac.orig
+++ configure.ac
@@ -127,7 +127,7 @@
 # ========
 # Find icu
 # ========
-PKG_CHECK_MODULES([ICU], [icu-i18n])
+PKG_CHECK_MODULES([ICU], [icu-i18n icu-uc])
 AC_SUBST(ICU_CFLAGS)
 AC_SUBST(ICU_LIBS)
 
