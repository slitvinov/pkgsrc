$NetBSD: patch-external_mariadb-connector-c_fix-debug-i386.patch.0,v 1.3 2025/11/04 16:48:06 ryoon Exp $

* Fix build under NetBSD/i386 9.

--- external/mariadb-connector-c/fix-debug-i386.patch.0.orig
+++ external/mariadb-connector-c/fix-debug-i386.patch.0
@@ -0,0 +1,18 @@
+--- libmariadb/ma_context.c.orig
++++ libmariadb/ma_context.c
+@@ -452,6 +452,7 @@
+   */
+   __asm__ __volatile__
+     (
++     ".cfi_startproc\n\t"
+      "movl %%esp, (%[save])\n\t"
+      "movl %[stack], %%esp\n\t"
+ #if defined(__GCC_HAVE_DWARF2_CFI_ASM) || (defined(__clang__) && __clang_major__ < 13)
+@@ -492,6 +493,7 @@
+      "3:\n\t"
+      "movl $1, %[ret]\n"
+      "4:\n"
++     ".cfi_endproc\n\t"
+      : [ret] "=a" (ret),
+        [f] "+c" (f),
+        [d] "+d" (d)
